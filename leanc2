#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ELAN_HOME_DIR=${ELAN_HOME:-"$HOME/.elan"}

usage() {
  cat <<'EOF'
Usage: ./leanc2 [command]

Commands:
  build   Build the Lean project (default)
  check   Build the root Lean target
  clean   Remove Lake build artifacts
  help    Show this help message

Environment:
  LAKE    Optional path to the Lake executable to use
EOF
}

run_lake() {
  if [ -n "${LAKE:-}" ]; then
    "$LAKE" "$@"
    return
  fi

  if command -v lake >/dev/null 2>&1; then
    lake "$@"
    return
  fi

  if [ -x "$ELAN_HOME_DIR/bin/lake" ]; then
    "$ELAN_HOME_DIR/bin/lake" "$@"
    return
  fi

  if command -v elan >/dev/null 2>&1; then
    elan run lake "$@"
    return
  fi

  printf '%s\n' "error: could not find 'lake'. Install elan from https://leanprover.github.io/elan/." >&2
  exit 1
}

cd "$ROOT_DIR"

command=${1:-build}
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  build)
    run_lake build "$@"
    ;;
  check)
    run_lake build LeanC2 "$@"
    ;;
  clean)
    run_lake clean "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf '%s\n\n' "error: unknown command '$command'" >&2
    usage >&2
    exit 1
    ;;
esac
